---
import SectionLabel from './SectionLabel.astro';
interface Props { variant?: 'default' | 'landing'; }
const { variant = 'default' } = Astro.props;
---
<section id="about" class:list={['about-acblpe', { landing: variant === 'landing' }]} aria-labelledby="about-title">
  {variant === 'landing' && <div class="landing-label"><SectionLabel number="02" label="About ACBLPE" light /></div>}
  <div class="about-layout">
    <div class="about-brand">
      <a class="acblpe-logo" href="https://www.acblpe.com/en" target="_blank" rel="noopener noreferrer" aria-label="ACBLPE (opens in a new tab)">
        <img src={variant === 'landing' ? '/acblpe-logo-light.svg' : '/acblpe-logo.svg'} width="400" height="125" alt="" loading="lazy" decoding="async" />
      </a>
    </div>

    <div class="about-copy">
      <h2 id="about-title">About ACBLPE</h2>
      <p>
        <a href="https://www.acblpe.com/en" target="_blank" rel="noopener noreferrer" aria-label="ACBLPE (opens in a new tab)">ACBLPE</a> is a scientific association dedicated to the study of Iberian-lexified
        creole languages and their communities, and more generally linguistic
        contact involving Portuguese or Spanish.
      </p>
      <p>
        Since 2001 its annual meetings have been held in Europe, Africa, the
        Caribbean and South America, alternating where possible between the
        Iberian Peninsula and other parts of the world.
      </p>
      <p>
        The 25ᵗʰ Conference extends this trajectory to South Asia, bringing
        creolists into dialogue with researchers of the Indian Ocean’s
        linguistic and historical contexts.
      </p>
    </div>
  </div>
</section>

<style>
  .about-acblpe {
    box-sizing: border-box;
    min-height: 448px;
    padding: 72px 80px 112px;
    background: #faf7f0;
    color: #061238;
    font-family: 'Avenir Next', Avenir, 'Segoe UI', Arial, sans-serif;
    scroll-margin-top: 24px;
  }

  .about-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    max-width: 1104px;
    margin-inline: auto;
  }

  .about-brand { align-self: center; }
  .acblpe-logo { display: block; width: min(100%, 460px); border-radius: 2px; }
  .acblpe-logo img { display: block; width: 100%; height: auto; }
  .acblpe-logo:focus-visible { outline: 2px solid currentColor; outline-offset: 8px; }

  h2 {
    margin: 0 0 24px;
    color: #061238;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.8px;
  }

  .about-copy { color: #566984; font-size: 16px; line-height: 24px; }
  .about-copy p { margin: 0; }
  .about-copy p + p { margin-top: 24px; }
  .about-copy a { color: inherit; text-decoration: underline; text-underline-offset: .14em; }
  .about-copy a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .landing { min-height: 515px; padding: 96px 80px; background: #214cb5; color: #faf7f0; font-family: var(--landing-sans); }
  .landing-label { max-width: 1280px; margin: 0 auto 28px; }
  .landing .about-layout { max-width: 1280px; gap: 64px; }
  .landing .acblpe-logo { box-sizing: border-box; width: min(100%, 520px); padding: 32px 30px; border-radius: 0; background: #102c73; }
  .landing h2 { color: #faf7f0; font-family: var(--landing-serif); }
  .landing .about-copy { color: #faf7f0; font-size: 18px; line-height: 1.45; }
  @media (max-width: 1199px) {
    .landing { min-height: 0; padding: 64px 40px 72px; background: #193bb5; }
    .landing .about-layout { gap: 32px; }
    .landing h2 { font-size: 32px; }
    .landing .about-copy { font-size: 16px; line-height: 24px; }
  }
  @media (max-width: 767px) {
    .about-layout { grid-template-columns: minmax(0, 1fr); }
    .about-brand { align-self: start; }
    .acblpe-logo { max-width: 420px; }
    .landing .about-layout { gap: 40px; }
  }
  @media (max-width: 600px) {
    .landing { padding: 56px 24px; }
    .landing .acblpe-logo { padding: 24px 20px; }
    .landing h2 { font-size: 30px; }
  }
</style>
