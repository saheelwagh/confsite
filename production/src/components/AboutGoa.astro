---
import SectionLabel from './SectionLabel.astro';
const facts = [
  { title: 'Language', description: 'Konkani is Goa’s official language; Marathi, Hindi and English are widely spoken, and Portuguese survives in older families and place names.' },
  { title: 'Climate', description: 'The conference falls at the tail of the monsoon. Expect warm, humid days around 28–30°C, occasional showers and a countryside at its greenest.' },
  { title: 'Heritage', description: '451 years of Portuguese rule left Goa a blend of Indian and Iberian worlds — baroque churches, whitewashed chapels, azulejo tiles and Indo-Portuguese mansions.' },
  { title: 'Food', description: 'Fish curry rice, xacuti, sorpotel, vindaloo and bebinca. Vegetarian thalis and international cuisine are easy to find everywhere.' },
];
---

<section class="about-goa" aria-labelledby="goa-title">
  <div class="content">
    <SectionLabel number="01" label="About Goa" />
    <h1 id="goa-title">A small state with a proud history</h1>
    <div class="facts">
      {facts.map(({ title, description }) => <article class="fact"><h2>{title}</h2><p>{description}</p></article>)}
    </div>
  </div>
</section>

<style>
  .about-goa { padding: 80px; background: #faf7f0; color: #152d53; }
  .content { max-width: 1104px; margin-inline: auto; }
  h1 { margin: 16px 0 0; font-family: var(--landing-serif); font-size: 44px; font-weight: 400; line-height: 1.25; letter-spacing: -1.4px; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 40px; }
  .fact { box-sizing: border-box; min-height: 174px; padding: 32px; border: 1px solid #ccd1d4; border-radius: 3px; background: #fffdf8; }
  .fact:nth-child(odd) { border-color: #214cb5; background: #214cb5; color: #f7f6f0; }
  .fact h2 { margin: 0; font-size: 12px; font-weight: 600; line-height: 15px; letter-spacing: 1.8px; text-transform: uppercase; }
  .fact p { margin: 16px 0 0; font-size: 16px; line-height: 1.6; }
  @media (max-width: 1199px) {
    .about-goa { padding: 72px 40px; }
    h1 { font-size: 40px; letter-spacing: -1.2px; }
    .facts { margin-top: 32px; }
    .fact { padding: 24px; }
  }
  @media (max-width: 600px) {
    .about-goa { padding: 56px 24px; }
    h1 { font-size: 32px; letter-spacing: -1px; }
    .facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>
