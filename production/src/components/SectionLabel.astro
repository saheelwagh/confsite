---
interface Props { number?: string; label: string; light?: boolean; gold?: boolean; }
const { number, label, light = false, gold = false } = Astro.props;
---
<p class:list={['section-label', { light, gold }]}>
  {number && <><span class="section-number">{number}</span><span class="rule" aria-hidden="true"></span></>}<span class="label">{label}</span>
</p>
<style>
  .section-label { display: flex; align-items: center; gap: 16px; margin: 0; color: #214cb5; font-family: var(--landing-sans, 'Inter', sans-serif); font-size: 11px; font-weight: 400; line-height: 15px; }
  .section-number { flex-shrink: 0; letter-spacing: 0; }
  .rule { width: 40px; height: 1px; flex-shrink: 0; background: currentColor; }
  .label { min-width: 0; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; }
  .light { color: #faf7f0; }
  .light .rule { background: #d4def3; }
  .gold { color: #d5a139; }
  @media (max-width: 1199px) {
    .section-label { gap: 10px; }
    .rule { width: 24px; }
  }
</style>
