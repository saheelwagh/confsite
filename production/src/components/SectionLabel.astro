---
interface Props { number: string; label: string; light?: boolean; }
const { number, label, light = false } = Astro.props;
---
<p class:list={['section-label', { light }]}>
  <span>{number}</span><span class="rule" aria-hidden="true"></span><span class="label">{label}</span>
</p>
<style>
  .section-label { display: flex; align-items: center; gap: 16px; margin: 0; color: #214cb5; font-family: var(--landing-sans, 'Inter', sans-serif); font-size: 11px; line-height: 13px; }
  .rule { width: 40px; height: 1px; flex-shrink: 0; background: currentColor; }
  .label { font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; }
  .light { color: #faf7f0; }
  .light .rule { background: #d4def3; }
  @media (max-width: 1199px) {
    .section-label { gap: 10px; line-height: 15px; }
    .rule { width: 24px; }
  }
</style>
