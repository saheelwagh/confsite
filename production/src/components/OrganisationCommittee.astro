---
import SectionLabel from './SectionLabel.astro';
const organisations = [
  'Goa University',
  'ACBLPE',
  'Directorate, Visiting Research Professor Programme',
  'Joaquim Heliodoro da Cunha Rivara Chair',
  'Camões I.P.',
  'CLP-Camões, Goa',
];
const committee = [
  { name: 'Prof. Anuradha Wagle', role: 'Dean, SGSLL' },
  { name: 'Dr. Prakash Parienkar', role: 'Director, VRPP' },
  { name: 'Delfim Correia da Silva', role: 'CLP-Camões, Goa' },
  { name: 'Loraine Alberto', role: 'P.D.M.A. Portuguese' },
  { name: 'Dhruv Usgaonkar', role: '' },
  { name: 'Jeanette Barbosa Noronha', role: '' },
];
---

<section id="committees" class="organisation-section" aria-labelledby="organisation-title">
  <div class="content">
    <SectionLabel number="01" label="Organisation" />
    <h1 id="organisation-title">A shared scholarly undertaking.</h1>
    <div class="organisation-layout">
      <div>
        <h2>Organisation</h2>
        <ul class="organisations">
          {organisations.map((organisation) => <li>{organisation}</li>)}
        </ul>
      </div>
      <div>
        <h2>Organising committee</h2>
        <ul class="organising-committee">
          {committee.map(({ name, role }) => (
            <li><span class="member-name">{name}</span>{role && <span class="member-role">{role}</span>}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .organisation-section { box-sizing: border-box; min-height: 941px; padding: 96px 80px; background: #eaf0f7; color: #152d53; font-family: var(--landing-sans, Arial, sans-serif); scroll-margin-top: 24px; }
  .content { max-width: 1280px; margin-inline: auto; }
  h1 { margin: 28px 0 0; font-family: var(--landing-serif, Georgia, serif); font-size: 52px; font-weight: 400; line-height: 1.22; letter-spacing: -1.7px; }
  .organisation-layout { display: grid; grid-template-columns: 500px minmax(0, 1fr); gap: 80px; margin-top: 48px; }
  h2 { margin: 0; color: #214cb5; font-size: 12px; font-weight: 600; line-height: 15px; letter-spacing: 1.5px; text-transform: uppercase; }
  ul { margin: 30px 0 0; padding: 0; list-style: none; }
  li { box-sizing: border-box; min-height: 79px; padding: 20px 0; border-top: 1px solid #ccd1d4; }
  .organisations li { font-family: var(--landing-serif, Georgia, serif); font-size: 25px; line-height: 1.5; letter-spacing: -0.5px; }
  .organising-committee li { display: grid; grid-template-columns: minmax(0, 360px) minmax(130px, 1fr); align-items: baseline; gap: 24px; padding-block: 24px; }
  .member-name { font-size: 20px; line-height: 1.5; }
  .member-role { color: #58677a; font-size: 16px; line-height: 1.6; }
  @media (max-width: 1199px) {
    .organisation-section { min-height: 0; padding: 72px 40px; }
    h1 { font-size: 40px; letter-spacing: -1.2px; }
    .organisation-layout { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 32px; margin-top: 40px; }
    .organisations li { font-size: 22px; }
    .organising-committee li { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .member-name { font-size: 18px; }
  }
  @media (max-width: 767px) {
    .organisation-layout { grid-template-columns: minmax(0, 1fr); gap: 48px; }
  }
  @media (max-width: 600px) {
    .organisation-section { padding: 56px 24px; }
    h1 { font-size: 32px; letter-spacing: -1px; }
    .organisations li { font-size: 22px; }
    .organisation-layout { margin-top: 32px; }
  }
</style>
