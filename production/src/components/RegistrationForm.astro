---
import SectionLabel from './SectionLabel.astro';
import { registrationCategories } from '../data/registration';
---

<section id="registration-form" class="registration-form" aria-labelledby="form-title">
  <div class="content">
    <SectionLabel number="02" label="Your details" />
    <div class="form-layout">
      <div class="form-introduction">
        <h2 id="form-title">Registration form</h2>
      </div>

      <form class="details-form" onsubmit="return false">
        <div class="text-fields">
          <div class="field">
            <label for="registration-name">Name <span aria-hidden="true">*</span></label>
            <input id="registration-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="registration-nationality">Nationality <span aria-hidden="true">*</span></label>
            <input id="registration-nationality" name="nationality" type="text" required />
          </div>
          <div class="field institution-field">
            <label for="registration-institution">Institution name <span aria-hidden="true">*</span></label>
            <input id="registration-institution" name="institution" type="text" autocomplete="organization" required />
          </div>
        </div>

        <div class="field category-field">
          <label for="registration-category">Participant category <span aria-hidden="true">*</span></label>
          <select id="registration-category" name="category" required>
            <option value="" disabled selected>Select your category</option>
            {registrationCategories.map(({ id, formLabel }) => (
              <option value={id}>{formLabel}</option>
            ))}
          </select>
        </div>

        <button type="submit" disabled>Submit registration <span aria-hidden="true">↗</span></button>
      </form>
    </div>
  </div>
</section>

<style>
  .registration-form { box-sizing: border-box; padding: 96px 80px 112px; background: #fffdf8; color: #152d53; font-family: var(--landing-sans, Arial, sans-serif); }
  .content { max-width: 1280px; margin-inline: auto; }
  .form-layout { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); align-items: start; gap: 80px; margin-top: 36px; }
  h2 { margin: 0; font-family: var(--landing-serif, Georgia, serif); font-size: 46px; font-weight: 400; line-height: 1.25; letter-spacing: -1.5px; }
  .details-form { min-width: 0; }
  .text-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 20px; }
  .institution-field { grid-column: 1 / -1; }
  .field label { display: block; margin-bottom: 12px; color: #214cb5; font-size: 12px; font-weight: 600; line-height: 18px; letter-spacing: 1.2px; text-transform: uppercase; }
  .field label span { color: #214cb5; }
  .field input, .field select { box-sizing: border-box; display: block; width: 100%; min-width: 0; height: 58px; padding: 14px 16px; border: 1px solid #cbd2d8; border-radius: 0; background: white; color: #152d53; font: inherit; font-size: 16px; }
  .field input:hover, .field select:hover { border-color: #8698b0; }
  .field input:focus-visible, .field select:focus-visible { outline: 2px solid #214cb5; outline-offset: 3px; }
  .category-field { margin-top: 34px; }
  button { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 54px; margin-top: 30px; padding: 16px 22px; border: 1px solid #aebbd1; background: #dbe3ef; color: #586a81; font: inherit; font-size: 14px; font-weight: 600; cursor: not-allowed; }

  @media (max-width: 1199px) {
    .registration-form { padding: 72px 40px 88px; }
    .form-layout { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 40px; }
    h2 { font-size: 38px; }
  }
  @media (max-width: 850px) {
    .form-layout { grid-template-columns: minmax(0, 1fr); gap: 38px; }
    .form-introduction { max-width: 600px; }
  }
  @media (max-width: 600px) {
    .registration-form { padding: 56px 24px 72px; }
    .form-layout { margin-top: 30px; gap: 32px; }
    h2 { font-size: 32px; }
    .text-fields { grid-template-columns: minmax(0, 1fr); }
    .institution-field { grid-column: auto; }
  }
</style>
