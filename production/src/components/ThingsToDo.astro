---
const activities = [
  { title: 'Heritage walk through Fontainhas', description: 'Panjim’s Latin Quarter, five minutes from the university — colour-washed Portuguese houses, chapels and bakeries.' },
  { title: 'Old Goa monuments', description: 'Bom Jesus Basilica, Se Cathedral and St. Augustine ruins, a UNESCO World Heritage ensemble about 30 km away.' },
  { title: 'Mandovi river cruise', description: 'Evening cruises from the Panjim jetty with Goan music and dance, a short ride from campus.' },
  { title: 'Divar and Chorao islands', description: 'Ferry crossings, village lanes and the Dr. Salim Ali Bird Sanctuary — at their most beautiful just after the rains.' },
  { title: 'Dudhsagar Falls day trip', description: 'One of India’s tallest waterfalls, at full force in early September, on the Karnataka border.' },
  { title: 'Spice plantation, Ponda', description: 'A guided walk through a working spice farm with a traditional Goan lunch, about 30 km inland.' },
  { title: 'Beaches near the city', description: 'Miramar and Dona Paula are minutes from campus; Calangute and Baga lie further north.' },
  { title: 'Goan food tour', description: 'Try local cafés and family kitchens for vindaloo, chorizo pão and bebinca dessert.' },
  { title: 'Forts of the coast', description: 'Fort Aguada and Chapora above the mouths of the Mandovi and Chapora rivers.' },
  { title: 'Art and museums', description: 'Museum of Goa in Pilerne and the Goa State Museum, both a short drive away.' },
];
---

<section class="things-to-do" aria-labelledby="activities-title">
  <div class="content">
    <p class="eyebrow">Around the conference dates</p>
    <h2 id="activities-title">Things to do</h2>
    <ol class="activities">
      {activities.map(({ title, description }, index) => <li>
        <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{title}</h3><p>{description}</p>
      </li>)}
    </ol>
  </div>
</section>

<style>
  .things-to-do { padding: 40px 80px 80px; background: #faf7f0; color: #152d53; }
  .content { max-width: 1104px; margin-inline: auto; }
  .eyebrow { margin: 0; color: #214cb5; font-size: 12px; font-weight: 600; line-height: 15px; letter-spacing: 1.8px; text-transform: uppercase; }
  h2 { margin: 16px 0 0; font-family: var(--landing-serif); font-size: 44px; font-weight: 400; line-height: 1.25; letter-spacing: -1.4px; }
  .activities { margin: 40px 0 0; padding: 0; list-style: none; border-bottom: 1px solid #ccd1d4; }
  li { display: grid; grid-template-columns: 32px 370px minmax(0, 1fr); align-items: start; gap: 32px; box-sizing: border-box; min-height: 98px; padding-block: 24px; border-top: 1px solid #ccd1d4; }
  .number { color: #214cb5; font-size: 12px; font-weight: 500; line-height: 1.7; }
  h3 { margin: 0; font-family: var(--landing-serif); font-size: 22px; font-weight: 400; line-height: 1.25; letter-spacing: -0.45px; }
  li p { margin: 0; color: #58677a; font-size: 14px; line-height: 1.6; }
  @media (max-width: 1199px) {
    .things-to-do { padding: 32px 40px 72px; }
    h2 { font-size: 40px; letter-spacing: -1.2px; }
    li { grid-template-columns: 32px minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 24px; }
    .activities { margin-top: 32px; }
  }
  @media (max-width: 767px) {
    li { grid-template-columns: 24px minmax(0, 1fr); column-gap: 16px; row-gap: 12px; }
    .number { grid-row: 1 / 3; }
    h3, li p { grid-column: 2; }
  }
  @media (max-width: 600px) {
    .things-to-do { padding: 24px 24px 56px; }
    h2 { font-size: 32px; letter-spacing: -1px; }
    h3 { font-size: 22px; }
  }
</style>
