---
interface NavigationLink {
  label: string;
  href: string;
}

interface Props {
  variant?: 'default' | 'landing';
  brand?: string;
  homeHref?: string;
  links?: NavigationLink[];
  callForPapersHref?: string;
  brandIcon?: string;
}

const {
  variant = 'default',
  brand = 'ACBLPE 2027',
  homeHref = '/landing',
  links = [
    { label: 'Home', href: '/' },
    { label: 'Registration', href: '/registration' },
    { label: 'People', href: '/people' },
    { label: 'Venue', href: '/venue' },
  ],
  callForPapersHref = '/call-for-papers',
  brandIcon,
} = Astro.props;
---

<header class:list={['site-header', { landing: variant === 'landing', 'with-brand-icon': !!brandIcon }]}>
  <nav aria-label="Main navigation">
    <a class="brand" href={homeHref}>
      {brandIcon && <img class="custom-brand-icon" src={brandIcon} width="30" height="30" alt="" />}
      <span>{brand}</span>
    </a>

    <ul id="navigation-links" class="navigation-links">
      {links.map(({ label, href }) => <li><a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a></li>)}
      <li>
        <a class="call-for-papers" href={callForPapersHref} aria-current={Astro.url.pathname === '/call-for-papers' ? 'page' : undefined}>
          Call for papers
          {variant === 'landing' ? <span aria-hidden="true">↗</span> : <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 9 9 3M3 3h6v6" stroke="currentColor" stroke-width="1.2" />
          </svg>}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --nav-ink: #132847;
    --nav-blue: #214ea2;
    color: var(--nav-ink);
    border-bottom: 1px solid rgb(19 40 71 / 18%);
    font-family: 'Avenir Next', Avenir, 'Segoe UI', Arial, sans-serif;
  }

  nav {
    min-height: 99px;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-sizing: content-box;
  }

  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--nav-blue); outline-offset: 5px; }
  .brand { display: inline-flex; align-items: center; gap: 16px; flex-shrink: 0; font-size: 20px; font-weight: 700; line-height: 1.2; }
  .navigation-links { display: flex; align-items: center; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .navigation-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; white-space: nowrap; }
  .navigation-links a:hover { color: var(--nav-blue); text-decoration: underline; text-underline-offset: 5px; }
  .navigation-links .call-for-papers { min-height: 42px; padding-inline: 17px; gap: 6px; border: 1px solid var(--nav-blue); color: var(--nav-blue); box-sizing: border-box; }
  .call-for-papers:hover { background: rgb(33 78 162 / 6%); }
  .landing { --nav-ink: #152d53; --nav-blue: #214cb5; border-color: #ccd1d4; font-family: var(--landing-sans); }
  .landing nav { padding-inline: 80px; }
  .landing .brand { font-weight: 600; letter-spacing: -0.5px; }
  .landing .navigation-links a { min-height: 41px; }
  .landing .navigation-links .call-for-papers { padding-inline: 18px; font-weight: 500; }
  .landing .brand { gap: 12px; }
  .landing a[aria-current='page'] { color: var(--nav-blue); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1199px) {
    .landing nav { position: relative; box-sizing: border-box; min-height: 117px; padding: 20px 40px 7px; flex-direction: column; align-items: flex-start; gap: 6px; }
    .landing .brand { min-height: 41px; }
    .landing .navigation-links { gap: 30px; }
    /* Expand touch targets while keeping the link text at its existing vertical position. */
    .landing .navigation-links a { min-height: 44px; line-height: 17px; }
    .landing .navigation-links li:last-child { position: absolute; top: 20px; right: 40px; }
    .landing .navigation-links .call-for-papers { min-height: 44px; }
  }
  @media (max-width: 600px) {
    .landing nav { padding-inline: 24px; }
    .landing .navigation-links { width: 100%; justify-content: space-between; gap: 8px; }
    .landing .navigation-links li:last-child { right: 24px; }
    .landing .navigation-links .call-for-papers { padding-inline: 10px; font-size: 13px; }
    .with-brand-icon .custom-brand-icon { display: none; }
    .with-brand-icon .navigation-links { flex-wrap: wrap; row-gap: 18px; }
  }
</style>
