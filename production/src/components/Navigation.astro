---
interface NavigationLink {
  label: string;
  href: string;
}

interface Props {
  brand?: string;
  homeHref?: string;
  links?: NavigationLink[];
  registrationHref?: string;
}

const {
  brand = 'ACBLPE 2027',
  homeHref = '/',
  links = [
    { label: 'About', href: '/#about' },
    { label: 'Call for papers', href: '/#call-for-papers' },
    { label: 'Speakers', href: '/#speakers' },
    { label: 'Venue', href: '/#venue' },
    { label: 'Committees', href: '/#committees' },
  ],
  registrationHref = '/#registration',
} = Astro.props;
---

<header class="site-header">
  <nav aria-label="Main navigation">
    <a class="brand" href={homeHref}>
      <svg class="brand-mark" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M1 1h22v22H1zM12 1v22M1 12h22" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span>{brand}</span>
    </a>

    <ul id="navigation-links" class="navigation-links">
      {links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      <li>
        <a class="registration" href={registrationHref}>
          Registration
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 9 9 3M3 3h6v6" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --nav-ink: #132847;
    --nav-blue: #214ea2;
    color: var(--nav-ink);
    border-bottom: 1px solid rgb(19 40 71 / 18%);
    font-family: 'Avenir Next', Avenir, 'Segoe UI', Arial, sans-serif;
  }

  nav {
    min-height: 99px;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-sizing: content-box;
  }

  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--nav-blue); outline-offset: 5px; }
  .brand { display: inline-flex; align-items: center; gap: 16px; flex-shrink: 0; font-size: 20px; font-weight: 700; line-height: 1.2; }
  .brand-mark { color: var(--nav-blue); flex-shrink: 0; }
  .navigation-links { display: flex; align-items: center; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .navigation-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; white-space: nowrap; }
  .navigation-links a:hover { color: var(--nav-blue); text-decoration: underline; text-underline-offset: 5px; }
  .navigation-links .registration { min-height: 42px; padding-inline: 17px; gap: 6px; border: 1px solid var(--nav-blue); color: var(--nav-blue); box-sizing: border-box; }
  .registration:hover { background: rgb(33 78 162 / 6%); }
</style>
