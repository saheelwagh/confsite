---
import SectionLabel from './SectionLabel.astro';
const criteria = [
  {
    title: 'Relevance & originality',
    description: 'The relevance and significance of the proposed topic and/or the originality of the study.',
  },
  {
    title: 'Argumentation',
    description: 'The argumentation (including the clarity of the argument and the results/conclusions).',
  },
  {
    title: 'Research & theory',
    description: 'Knowledge of the relevant research literature and theory.',
  },
];
const languages = ['English', 'French', 'Portuguese', 'Spanish'];
---

<section id="review-and-presentation" class="review-guidance" aria-labelledby="review-title">
  <div class="guidance-content">
    <SectionLabel number="02" label="Review Guidelines" />
    <h2 id="review-title">Clarity in research. Dialogue in presentation.</h2>
    <p class="review-introduction">Reviewer instructions: abstracts will be assessed based on the following three criteria:</p>

    <ol class="criteria">
      {criteria.map(({ title, description }, index) => (
        <li class="criterion">
          <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>

    <div class="presentation-layout">
      <div class="language-guidance">
        <h3>Accepted Langauges:</h3>
        <ul class="languages" aria-label="Accepted abstract languages">
          {languages.map((language) => <li>{language}</li>)}
        </ul>
        <p>Abstracts may be submitted in English, French, Portuguese or Spanish. Presentations should be delivered in the same language as the abstract, although the screen language and spoken language may differ.</p>
      </div>

      <aside class="session-card" aria-labelledby="session-title">
        <h3 id="session-title">Format</h3>
        <div class="session-breakdown">
          <div class="session-part"><p class="minutes">20</p><p class="session-caption">min presentation</p></div>
          <span class="plus" aria-hidden="true">+</span>
          <div class="session-part"><p class="minutes">10</p><p class="session-caption">min discussion</p></div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .review-guidance { box-sizing: border-box; padding: 96px 80px; background: #f8f6f0; color: #152d53; font-family: var(--landing-sans, Arial, sans-serif); scroll-margin-top: 24px; }
  .guidance-content { max-width: 1280px; margin-inline: auto; }
  h2 { margin: 28px 0 0; font-family: var(--landing-serif, Georgia, serif); font-size: 52px; font-weight: 400; line-height: 1.22; letter-spacing: -1.7px; }
  .review-introduction { margin: 40px 0 0; color: #58677a; font-size: 18px; line-height: 1.6; }
  .criteria { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 30px 0 0; padding: 0; list-style: none; }
  .criterion { padding: 24px; border-top: 2px solid #214cb5; }
  .criterion:nth-child(2) { background: #214cb5; border-top-color: #d5a139; color: #fffdf8; }
  .criterion:nth-child(2) .number { color: #e7be6b; }
  .criterion:nth-child(2) p { color: #e8efff; }
  .number { color: #214cb5; font-family: var(--landing-serif, Georgia, serif); font-size: 32px; line-height: 40px; }
  .criterion h3 { margin: 22px 0 0; font-family: var(--landing-serif, Georgia, serif); font-size: 24px; font-weight: 400; line-height: 1.3; letter-spacing: -0.5px; }
  .criterion p { margin: 22px 0 0; color: #58677a; font-size: 18px; line-height: 1.65; }
  .presentation-layout { display: grid; grid-template-columns: minmax(0, 700px) minmax(340px, 1fr); align-items: start; gap: 64px; margin-top: 40px; padding-top: 58px; border-top: 1px solid #ccd1d4; }
  .language-guidance h3 { margin: 0; font-family: var(--landing-serif, Georgia, serif); font-size: 32px; font-weight: 400; line-height: 1.25; }
  .languages { display: flex; flex-wrap: wrap; margin: 24px 0 0; padding: 0; color: #214cb5; list-style: none; font-size: 17px; font-weight: 500; line-height: 1.6; }
  .languages li + li::before { content: '·'; display: inline-block; margin-inline: 5px; }
  .language-guidance > p { margin: 24px 0 0; color: #58677a; font-size: 18px; line-height: 1.7; }
  .session-card { box-sizing: border-box; padding: 32px; background: #eaf0f7; }
  .session-card h3 { margin: 0; color: #214cb5; font-size: 12px; font-weight: 400; line-height: 18px; letter-spacing: 1.3px; text-transform: uppercase; }
  .session-breakdown { display: flex; align-items: center; gap: 26px; margin-top: 22px; }
  .session-part { min-width: 0; }
  .minutes { margin: 0; font-family: var(--landing-serif, Georgia, serif); font-size: 54px; line-height: 1.25; }
  .session-caption { margin: 8px 0 0; color: #58677a; font-size: 14px; line-height: 20px; }
  .plus { color: #214cb5; font-family: var(--landing-serif, Georgia, serif); font-size: 32px; line-height: 1.25; }
  @media (max-width: 1199px) {
    .review-guidance { padding: 72px 40px; }
    h2 { font-size: 40px; letter-spacing: -1.2px; }
    .criteria { gap: 24px; }
    .criterion h3 { font-size: 22px; }
    .review-introduction, .criterion p, .language-guidance > p { font-size: 16px; }
    .presentation-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; padding-top: 40px; }
    .language-guidance h3 { font-size: 26px; }
    .session-card { padding: 24px; }
    .session-breakdown { gap: 20px; }
  }
  @media (max-width: 767px) {
    .criteria, .presentation-layout { grid-template-columns: minmax(0, 1fr); }
    .criterion { padding-bottom: 0; }
    .criterion:nth-child(2) { padding-bottom: 24px; }
  }
  @media (max-width: 600px) {
    .review-guidance { padding: 56px 24px; }
    h2 { font-size: 32px; letter-spacing: -1px; }
    .review-introduction { margin-top: 32px; }
    .language-guidance h3 { font-size: 24px; }
    .session-card { padding: 24px; }
    .session-breakdown { gap: 16px; }
    .minutes { font-size: 48px; }
    .session-caption { font-size: 13px; }
  }
</style>
