---
import SectionLabel from './SectionLabel.astro';
interface Props { satellite?: boolean; }
const { satellite = false } = Astro.props;

const conferenceMembers = [
  { name: 'Alan Baxter', affiliation: 'Universidade Federal da Bahia' },
  { name: 'Alexandre Cobbinah', affiliation: 'Universidade de São Paulo' },
  { name: 'Ana Paula Braga Mattos', affiliation: 'Aarhus University' },
  { name: 'Clancy Clements', affiliation: 'Indiana University' },
  { name: 'Dominika Swolkien', affiliation: 'Universidade de Cabo Verde' },
  { name: 'Eduardo Tobar Delgado', affiliation: 'Escola de Idiomas de Vigo' },
  { name: 'Eeva Sippola', affiliation: 'University of Helsinki' },
  { name: 'Hugo Cardoso', affiliation: 'Universidade de Lisboa' },
  { name: 'Jean-Louis Rougé', affiliation: 'Université d’Orléans' },
  { name: 'Joachim Steffen', affiliation: 'Universität Augsburg' },
  { name: 'Kofi Yakpo', affiliation: 'The University of Hong Kong' },
  { name: 'Laura Álvarez López', affiliation: 'University of Stockholm' },
  { name: 'Liliana Inverno', affiliation: 'Universidade de Coimbra' },
  { name: 'Marlyse Baptista', affiliation: 'University of Pennsylvania' },
  { name: 'Miguel Gutiérrez Maté', affiliation: 'Universität Augsburg' },
  { name: 'Márcia Oliveira', affiliation: 'Universidade de São Paulo' },
  { name: 'Mauro Fernández', affiliation: 'Universidade da Coruña' },
  { name: 'Nélia Alexandre', affiliation: 'Universidade de Lisboa' },
  { name: 'Nicolas Quint', affiliation: 'Centre National de la Recherche Scientifique – Paris' },
  { name: 'Rita Gonçalves', affiliation: 'Universidade de Lisboa' },
  { name: 'Sandro Sessarego', affiliation: 'University of Texas at Austin' },
  { name: 'Susana Castillo Rodríguez', affiliation: 'SUNY – State University of New York College - Geneseo' },
  { name: 'Tjerk Hagemeijer', affiliation: 'Universidade de Lisboa' },
];
const satelliteMembers = [
  { name: 'Anuradha Wagle', discipline: 'French' },
  { name: 'Vrushali Mandrekar', discipline: 'Hindi' },
  { name: 'Sunita Umraskar', discipline: 'Marathi' },
  { name: 'Anjali Chaubey', discipline: 'English' },
  { name: 'Edna Vaz', discipline: 'Konkani' },
];

const sectionId = satellite ? 'satellite-scientific-committee' : 'scientific-committee';
const titleId = satellite ? 'satellite-scientific-title' : 'scientific-title';
const members = satellite
  ? satelliteMembers.map(({ name, discipline }) => ({ name, detail: `Discipline of ${discipline}` }))
  : conferenceMembers.map(({ name, affiliation }) => ({ name, detail: affiliation }));
---

<section id={sectionId} class:list={['committee', sectionId]} aria-labelledby={titleId}>
  <div class="content">
    <SectionLabel number={satellite ? '03' : '02'} label={satellite ? 'Satellite Conference Scientific Committee' : 'Conference Scientific Committee'} />
    <h2 id={titleId}>{satellite ? 'Satellite Conference Scientific Committee' : 'ACBLPE Conference Scientific Committee'}</h2>
    <ul class="members">
      {members.map(({ name, detail }) => (
        <li><h3>{name}</h3><p>{detail}</p></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .committee { box-sizing: border-box; min-height: 1324px; padding: 96px 80px; background: #faf7f0; color: #152d53; font-family: var(--landing-sans, Arial, sans-serif); scroll-margin-top: 24px; }
  .content { max-width: 1280px; margin-inline: auto; }
  h2 { margin: 28px 0 0; font-family: var(--landing-serif, Georgia, serif); font-size: 52px; font-weight: 400; line-height: 1.22; letter-spacing: -1.7px; }
  .members { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(8, minmax(113px, auto)); grid-auto-flow: column; column-gap: 40px; margin: 50px 0 0; padding: 0; list-style: none; }
  .members li { box-sizing: border-box; padding: 22px 0; border-top: 1px solid #ccd1d4; }
  .members li:nth-child(8), .members li:nth-child(16), .members li:last-child { border-bottom: 1px solid #ccd1d4; }
  .members h3 { margin: 0; font-size: 21px; font-weight: 500; line-height: 1.4; }
  .members p { margin: 8px 0 0; color: #58677a; font-size: 15px; line-height: 1.6; }
  @media (max-width: 1199px) {
    .committee { min-height: 0; padding: 72px 40px; }
    h2 { font-size: 40px; letter-spacing: -1.2px; }
    .members { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(12, minmax(113px, auto)); column-gap: 32px; margin-top: 40px; }
    .members li:nth-child(8), .members li:nth-child(16) { border-bottom: 0; }
    .members li:nth-child(12) { border-bottom: 1px solid #ccd1d4; }
  }
  @media (max-width: 600px) {
    .committee { padding: 56px 24px; }
    h2 { font-size: 32px; letter-spacing: -1px; }
    .members { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-auto-flow: row; margin-top: 32px; }
    .members li { min-height: 113px; }
    .members li:nth-child(12) { border-bottom: 0; }
  }
  .satellite-scientific-committee { min-height: 0; background: #f1ebe0; color: #102746; }
  .satellite-scientific-committee .members { grid-template-rows: none; grid-auto-flow: row; }
  .satellite-scientific-committee .members li { border-color: #c8beb1; }
  .satellite-scientific-committee .members li:last-child { border-bottom: 0; }
  .satellite-scientific-committee .members p { color: #46556a; }
</style>
