---
import SectionLabel from './SectionLabel.astro';
interface Props {
  variant?: 'default' | 'landing';
  status?: string;
  location?: string;
  abstractHref?: string;
  registrationHref?: string;
}

const {
  variant = 'default',
  status = 'Call for abstracts open',
  location = 'Goa University · India',
  abstractHref = '/call-for-papers',
  registrationHref = '/registration',
} = Astro.props;
---

<!-- Figma: Conference hero / Desktop (17:151), 1440 × 600. -->
<section class:list={['conference-hero', { landing: variant === 'landing' }]} aria-labelledby="conference-title">
  {variant === 'landing' && <div class="responsive-label"><SectionLabel number="01" label="Introduction" /></div>}
  <div class="hero-content">
    <div class="hero-meta">
      <span class="status">{status}</span>
      <span class="location">{location}</span>
    </div>

    {variant === 'landing' ? (
      <h1 id="conference-title"><span class="accent">25th Annual Conference</span> of the Association of Portuguese and Spanish-Lexified Creoles (ACBLPE)</h1>
    ) : (
      <h1 id="conference-title">Iberian-Lexified Creoles:<br /><span class="accent">A Global Conversation</span> in Goa</h1>
    )}

    <div class="hero-footer">
      <p class="description">
        <a href="https://www.acblpe.com/en" target="_blank" rel="noopener noreferrer" aria-label="ACBLPE (opens in a new tab)">ACBLPE</a> in its 25th edition arrives in South Asia for the first time. The Call for Papers is now open
      </p>
      <div class="hero-actions">
        <a class="button primary" href={abstractHref}>
          {variant === 'landing' ? 'Explore the CFP' : 'Submit an abstract'}
          {variant === 'landing' && <img src="/landing/arrow-down-right-light.svg" width="18" height="18" alt="" />}
          {variant === 'landing' && <span class="responsive-arrow" aria-hidden="true">↘</span>}
        </a>
        <a class="button secondary" href={registrationHref}>Registration
          {variant === 'landing' && <img src="/landing/arrow-down-right-blue.svg" width="18" height="18" alt="" />}
          {variant === 'landing' && <span class="responsive-arrow" aria-hidden="true">↘</span>}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .responsive-label, .responsive-arrow, .mobile-break { display: none; }
  .conference-hero {
    --hero-paper: #faf7f0;
    --hero-ink: #061238;
    --hero-blue: #0f33c2;
    --hero-gold: #f5b23b;
    min-height: 600px;
    box-sizing: border-box;
    padding: 64px 80px;
    background: var(--hero-paper);
    color: var(--hero-ink);
    font-family: 'Avenir Next', Avenir, 'Segoe UI', Arial, sans-serif;
  }

  .hero-content { max-width: 1280px; margin-inline: auto; }
  .hero-meta { display: flex; align-items: center; gap: 16px; font-size: 12px; line-height: 18px; }
  .status { padding: 4px 12px; border-radius: 999px; background: var(--hero-gold); }
  .location { color: #40577c; }

  h1 {
    margin: 24px 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 112px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -3px;
  }

  h1 .accent { color: var(--hero-blue); }
  .hero-footer { display: flex; align-items: center; justify-content: space-between; gap: 40px; margin-top: 48px; }
  .description { margin: 0; color: #40577c; font-size: 18px; line-height: 26px; }
  .description a { color: inherit; text-decoration: underline; text-underline-offset: .14em; }
  .description a:focus-visible { outline: 2px solid var(--hero-blue); outline-offset: 3px; }
  .hero-actions { display: flex; flex-shrink: 0; align-items: center; gap: 12px; }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 24px;
    box-sizing: border-box;
    border: 1px solid var(--hero-blue);
    border-radius: 999px;
    font-size: 16px;
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary { background: var(--hero-blue); color: var(--hero-paper); }
  .secondary { color: var(--hero-blue); }
  .primary:hover { background: var(--hero-ink); border-color: var(--hero-ink); }
  .secondary:hover { background: rgb(15 51 194 / 6%); }
  .button:focus-visible { outline: 2px solid var(--hero-blue); outline-offset: 5px; }
  .landing { --hero-blue: #214cb5; position: relative; font-family: var(--landing-sans); }
  .landing .responsive-label { display: block; position: absolute; top: 24px; left: max(80px, calc((100% - 1280px) / 2)); }
  .landing .hero-meta { gap: 12px; line-height: 17.4px; }
  .landing .status { padding-block: 5px; }
  .landing .location, .landing .description { color: #425475; }
  .landing h1 { margin-top: 28px; font-family: var(--landing-serif); font-size: clamp(42px, 5vw, 70px); line-height: 1.12; letter-spacing: -.04em; }
  .landing .second-line { margin-left: 1.4em; }
  .landing .hero-footer { margin-top: 34px; gap: 32px; }
  .landing .description { max-width: 640px; line-height: 1.45; }
  .landing .hero-actions { gap: 12px; }
  .landing .button { min-height: 54px; border-radius: 0; gap: 24px; font-size: 14px; font-weight: 600; line-height: 17px; }
  .landing .primary { width: 267px; }
  .landing .secondary { width: 173px; }
  .landing .button img { flex-shrink: 0; }
  @media (max-width: 1199px) {
    .landing { position: relative; min-height: 570px; padding: 56px 40px; }
    .landing .responsive-label { display: block; position: absolute; top: 20px; left: 40px; }
    .landing h1 { font-size: clamp(40px, 5vw, 58px); }
    .landing .second-line { margin-left: 0; }
    .landing .hero-footer { flex-direction: column; align-items: flex-start; margin-top: 30px; gap: 28px; }
    .landing .description { max-width: none; font-size: 16px; }
    .landing .description br { display: none; }
    .landing .button { min-height: 56px; gap: 16px; }
    .landing .secondary { width: 161px; }
    .landing .button img { display: none; }
    .landing .responsive-arrow { display: inline; }
  }
  @media (max-width: 600px) {
    .landing { min-height: 650px; padding: 40px 24px 56px; }
    .landing .responsive-label { left: 24px; }
    .landing .hero-meta { flex-direction: column; align-items: flex-start; gap: 10px; }
    .landing h1 { margin-top: 27px; font-size: clamp(30px, 7vw, 38px); }
    .landing .mobile-break { display: initial; }
    .landing .hero-footer { margin-top: 28px; gap: 29px; }
    .landing .description { font-size: 16px; }
    .landing .hero-actions { flex-direction: column; align-items: flex-start; width: 100%; }
    .landing .button { max-width: 100%; }
  }
</style>
