---
import Navigation from '../components/Navigation.astro';
import MinimalFooter from '../components/MinimalFooter.astro';
import AzulejoArtwork from '../components/AzulejoArtwork.astro';
import LandingFonts from '../components/LandingFonts.astro';
import SectionTracker from '../components/SectionTracker.astro';
import RegistrationFees from '../components/RegistrationFees.astro';
import RegistrationNotice from '../components/RegistrationNotice.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Registration', href: '/registration' },
  { label: 'People', href: '/people' },
  { label: 'Venue', href: '/venue' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Registration fees and opening status for the 25ᵗʰ ACBLPE Conference in Goa, 2027." />
    <title>Registration | ACBLPE 2027</title>
    <LandingFonts />
  </head>
  <body id="top" class="registration-page">
    <Navigation variant="landing" links={links} />
    <main id="main-content">
      <SectionTracker />
      <RegistrationFees />
      <RegistrationNotice />
      <AzulejoArtwork />
    </main>
    <MinimalFooter />
  </body>
</html>

<style is:global>
  .registration-page { --landing-sans: 'Landing Inter', Arial, sans-serif; --landing-serif: 'Landing Libre Baskerville', Georgia, serif; margin: 0; background: #fffdf8; color: #152d53; font-family: var(--landing-sans); }
</style>
