---
import Navigation from '../components/Navigation.astro';
import MinimalFooter from '../components/MinimalFooter.astro';
import LandingFonts from '../components/LandingFonts.astro';
import SectionTracker from '../components/SectionTracker.astro';
import OrganisationCommittee from '../components/OrganisationCommittee.astro';
import ScientificCommittee from '../components/ScientificCommittee.astro';
const links = [
  { label: 'Home', href: '/' },
  { label: 'Registration', href: '/registration' },
  { label: 'People', href: '/people' },
  { label: 'Venue', href: '/venue' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="People at the ACBLPE 2027 conference." />
    <title>People | ACBLPE 2027</title>
    <LandingFonts />
  </head>
  <body id="top" class="people-page">
    <Navigation variant="landing" homeHref="/landing" links={links} />
    <main id="main-content">
      <SectionTracker />
      <OrganisationCommittee />
      <ScientificCommittee />
    </main>
    <MinimalFooter />
  </body>
</html>

<style is:global>
  .people-page { --landing-sans: 'Landing Inter', Arial, sans-serif; --landing-serif: 'Landing Libre Baskerville', Georgia, serif; margin: 0; background: #faf7f0; color: #152d53; font-family: var(--landing-sans); }
</style>
