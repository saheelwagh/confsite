---
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import AboutACBLPE from '../components/AboutACBLPE.astro';
import Satellite from '../components/Satellite.astro';
import ConferenceVenue from '../components/ConferenceVenue.astro';
import KeynoteIntro from '../components/KeynoteIntro.astro';
import Timeline from '../components/Timeline.astro';
import MinimalFooter from '../components/MinimalFooter.astro';
import AzulejoArtwork from '../components/AzulejoArtwork.astro';
import LandingFonts from '../components/LandingFonts.astro';
import SectionTracker from '../components/SectionTracker.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Registration', href: '/registration' },
  { label: 'People', href: '/people' },
  { label: 'Venue', href: '/venue' },
];
const speakers = [
  { name: 'Prof. J. Clancy Clements', affiliation: 'Indiana University' },
  { name: 'Prof. Eeva Sippola', affiliation: 'University of Helsinki' },
  { name: 'Prof. Hugo C. Cardoso', affiliation: 'FLUL-Lisbon' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="The 25ᵗʰ ACBLPE Conference at Goa University: Creoles across the Indian Ocean, 1–3 September 2027." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <LandingFonts />
    <title>ACBLPE 2027 Goa</title>
  </head>
  <body id="top" class="landing-page">
    <Navigation variant="landing" links={links} />
    <main id="main-content">
      <SectionTracker />
      <Hero variant="landing" location="September 2027" />
      <AboutACBLPE variant="landing" />
      <Satellite variant="landing" />
      <ConferenceVenue variant="landing" venueHref="/venue" directionsHref="https://maps.app.goo.gl/bjPpmSJ6iYi32MFV6" />
      <KeynoteIntro variant="directory" speakers={speakers} />
      <Timeline variant="landing" />
      <AzulejoArtwork />
    </main>
    <MinimalFooter />
  </body>
</html>

<style is:global>
  .landing-page { --landing-sans: 'Landing Inter', Arial, sans-serif; --landing-serif: 'Landing Libre Baskerville', Georgia, serif; margin: 0; background: #faf7f0; color: #152d53; font-family: var(--landing-sans); }
</style>
